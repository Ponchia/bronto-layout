{
  "schemaVersion": 1,
  "url": "scroll-deep.html",
  "widths": [
    375,
    1280
  ],
  "actions": [
    {
      "type": "scroll-into-view",
      "selector": "#deep-heading"
    },
    {
      "type": "pause",
      "milliseconds": 120
    }
  ],
  "selectors": {
    "target": "#deep-heading"
  },
  "rules": [
    {
      "id": "deep-heading-exists",
      "type": "selector-count",
      "element": "target",
      "exactly": 1
    },
    {
      "id": "deep-heading-inside-viewport",
      "type": "contained",
      "element": "target",
      "in": "viewport",
      "axis": "y",
      "tolerance": 2
    },
    {
      "id": "deep-page-no-horizontal-overflow",
      "type": "document-overflow",
      "tolerance": 2
    }
  ]
}
