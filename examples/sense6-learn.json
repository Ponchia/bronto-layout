{
  "schemaVersion": 1,
  "url": "https://sense6.net/en/learn/",
  "widths": [320, 375, 768, 1280],
  "selectors": {
    "learn": ".learn-view",
    "hero": ".learn-hero",
    "topics": ".learn-topic-grid"
  },
  "rules": [
    { "id": "no-page-horizontal-overflow", "type": "document-overflow", "tolerance": 2 },
    { "id": "learn-present", "type": "selector-count", "element": "learn", "exactly": 1 },
    { "id": "topics-present", "type": "selector-count", "element": "topics", "exactly": 1 },
    { "id": "learn-fits-horizontally", "type": "contained", "element": "learn", "in": "viewport", "axis": "x", "tolerance": 2 },
    { "id": "topics-fits-horizontally", "type": "contained", "element": "topics", "in": "viewport", "axis": "x", "tolerance": 2 }
  ]
}
