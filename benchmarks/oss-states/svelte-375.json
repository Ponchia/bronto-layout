{
  "schemaVersion": 1,
  "url": "https://svelte.dev/docs/svelte/overview",
  "widths": [
    375
  ],
  "actions": [
    {
      "type": "click",
      "selector": "button.menu-toggle"
    },
    {
      "type": "pause",
      "milliseconds": 350
    }
  ],
  "selectors": {
    "opened": "button.menu-toggle[aria-expanded=\"true\"]",
    "button": "button.menu-toggle",
    "content": "main"
  },
  "rules": [
    {
      "id": "menu-open-state",
      "type": "selector-count",
      "element": "opened",
      "exactly": 1
    },
    {
      "id": "mobile-menu-button",
      "type": "selector-count",
      "element": "button",
      "exactly": 1
    },
    {
      "id": "main-document-present",
      "type": "selector-count",
      "element": "content",
      "exactly": 1
    }
  ]
}
