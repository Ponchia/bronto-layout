{
  "name": "@ponchia/layout",
  "version": "0.4.0",
  "description": "Open-source layout contracts, responsive diagnostics, and agent-ready CLI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bronto-layout": "./bin/bronto-layout.mjs"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run build && npm run lint && npm test",
    "demo": "node bin/bronto-layout.mjs --spec examples/layout.json --url examples/healthy.html",
    "demo:broken": "node bin/bronto-layout.mjs --spec examples/layout.json --url examples/broken.html",
    "demo:inspect": "node bin/bronto-layout.mjs inspect --url examples/healthy.html --width 375 --selector heading=.heading",
    "demo:scan": "node bin/bronto-layout.mjs scan --spec examples/responsive.json --scan 320:920:80 --refine",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "benchmark:audit": "node scripts/benchmark-audit.mjs --assert",
    "benchmark:audit:expanded": "node scripts/benchmark-audit.mjs --manifest benchmarks/audit-controlled-v0.2.json --assert",
    "benchmark:audit:locations": "node scripts/benchmark-audit.mjs --manifest benchmarks/audit-controlled-v0.3.json --assert",
    "field:validate": "node scripts/field-benchmark.mjs validate --manifest benchmarks/field-sites.v0.1.json && node scripts/field-benchmark.mjs validate --manifest benchmarks/field-sites.v0.2.json",
    "test:unit": "npm run build && node scripts/test-unit.mjs",
    "profile:cli": "node scripts/profile-cli.mjs",
    "lint": "eslint src bin scripts tests",
    "coverage:unit": "npm run build && node scripts/test-unit.mjs --coverage",
    "profile:stress": "npm run build && node scripts/profile-stress.mjs",
    "test:shard": "node scripts/ci-test-shards.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./sweep": {
      "types": "./dist/sweep.d.ts",
      "default": "./dist/sweep.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "default": "./dist/compare.js"
    },
    "./sarif": {
      "types": "./dist/sarif.d.ts",
      "default": "./dist/sarif.js"
    },
    "./contract-discovery": {
      "types": "./dist/contract-discovery.d.ts",
      "default": "./dist/contract-discovery.js"
    },
    "./selector-discovery": {
      "types": "./dist/selector-discovery.d.ts",
      "default": "./dist/selector-discovery.js"
    },
    "./schemas/layout-contract.schema.json": "./schemas/layout-contract.schema.json",
    "./schemas/batch-manifest.schema.json": "./schemas/batch-manifest.schema.json",
    "./schemas/layout-actions.schema.json": "./schemas/layout-actions.schema.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "examples",
    "docs",
    "schemas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ponchia/bronto-layout.git"
  },
  "homepage": "https://github.com/Ponchia/bronto-layout#readme",
  "bugs": {
    "url": "https://github.com/Ponchia/bronto-layout/issues"
  },
  "keywords": [
    "layout",
    "responsive",
    "css",
    "web",
    "devtools",
    "cli",
    "agent",
    "testing",
    "typescript"
  ]
}
