{
  "name": "@ponchia/layout",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source layout contracts, responsive diagnostics, and agent-ready CLI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bronto-layout": "./bin/bronto-layout.mjs"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run build && npm test",
    "demo": "node bin/bronto-layout.mjs --spec examples/layout.json --url examples/healthy.html",
    "demo:broken": "node bin/bronto-layout.mjs --spec examples/layout.json --url examples/broken.html",
    "demo:inspect": "node bin/bronto-layout.mjs inspect --url examples/healthy.html --width 375 --selector heading=.heading",
    "demo:scan": "node bin/bronto-layout.mjs scan --spec examples/responsive.json --scan 320:920:80 --refine"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./sweep": {
      "types": "./dist/sweep.d.ts",
      "default": "./dist/sweep.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "default": "./dist/compare.js"
    },
    "./sarif": {
      "types": "./dist/sarif.d.ts",
      "default": "./dist/sarif.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ]
}
