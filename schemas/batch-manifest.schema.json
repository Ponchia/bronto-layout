{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ponchia/bronto-layout/main/schemas/batch-manifest.schema.json",
  "title": "Bronto Layout v1 batch manifest",
  "description": "Finite, reviewable batch of contract checks and opt-in automatic audits. Run bronto-layout batch --dry-run to validate paths and referenced action files.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "schemaVersion": {
      "const": 1
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "description": "Contract-check batch job (default if mode is absent)",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
              },
              "url": {
                "type": "string",
                "pattern": "\\S"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8}){0,3}$"
              },
              "widths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 10000
                },
                "uniqueItems": true
              },
              "scan": {
                "type": "string",
                "pattern": "^[0-9]+:[0-9]+:[0-9]+$"
              },
              "cssBreakpoints": {
                "type": "boolean"
              },
              "colorScheme": {
                "enum": [
                  "light",
                  "dark"
                ]
              },
              "reducedMotion": {
                "type": "boolean"
              },
              "mobile": {
                "type": "boolean"
              },
              "layoutShifts": {
                "type": "boolean"
              },
              "mode": {
                "const": "check"
              },
              "spec": {
                "type": "string",
                "pattern": "\\S"
              },
              "stableFor": {
                "type": "integer",
                "minimum": 100,
                "maximum": 5000
              }
            },
            "required": [
              "id",
              "spec"
            ],
            "not": {
              "required": [
                "widths",
                "scan"
              ]
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "cssBreakpoints": {
                      "const": true
                    }
                  },
                  "required": [
                    "cssBreakpoints"
                  ]
                },
                "then": {
                  "required": [
                    "scan"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "description": "Zero-contract mechanical audit and optional review-only diagnostics",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
              },
              "url": {
                "type": "string",
                "pattern": "\\S"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8}){0,3}$"
              },
              "widths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 10000
                },
                "uniqueItems": true
              },
              "scan": {
                "type": "string",
                "pattern": "^[0-9]+:[0-9]+:[0-9]+$"
              },
              "cssBreakpoints": {
                "type": "boolean"
              },
              "colorScheme": {
                "enum": [
                  "light",
                  "dark"
                ]
              },
              "reducedMotion": {
                "type": "boolean"
              },
              "mobile": {
                "type": "boolean"
              },
              "layoutShifts": {
                "type": "boolean"
              },
              "mode": {
                "const": "audit"
              },
              "actions": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 1024
              },
              "gridGapReview": {
                "type": "boolean"
              },
              "siblingOverlapReview": {
                "type": "boolean"
              },
              "frameInventory": {
                "type": "boolean"
              },
              "failOnCoverageGaps": {
                "type": "boolean"
              },
              "domLimit": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 50000
              }
            },
            "required": [
              "id",
              "mode",
              "url"
            ],
            "not": {
              "required": [
                "widths",
                "scan"
              ]
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "cssBreakpoints": {
                      "const": true
                    }
                  },
                  "required": [
                    "cssBreakpoints"
                  ]
                },
                "then": {
                  "required": [
                    "scan"
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "jobs"
  ]
}
